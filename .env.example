# Copy to .env and replace every secret before deployment. NEVER commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_KEY
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=kinetra
POSTGRES_USER=kinetra
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_STRONG_DB_PASSWORD
# Only enable behind a trusted TLS-terminating reverse proxy:
TRUST_PROXY_SSL_HEADER=false
SECURE_SSL_REDIRECT=true
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For SMTP production email:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.provider.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=mailer@example.com
# EMAIL_HOST_PASSWORD=REPLACE
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=KINETRA <notifications@example.com>
